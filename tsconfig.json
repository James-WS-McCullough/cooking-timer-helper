{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vite-plugin-pwa/vue", "unplugin-icons/types/vue"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "lab/**/*.ts", "lab/**/*.vue"]
}
